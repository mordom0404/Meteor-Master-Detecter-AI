build/

# 每次构建生成的构建报告（源码提交 / Nuitka 版本 / 产物 SHA256 等），逐次覆盖
build_report.txt

# 冒烟测试产物（生成的样例图 + 引擎输出）
test_out/

# Project-local scratch / smoke / debug artifacts (renamed from _* prefix)
.temp/

